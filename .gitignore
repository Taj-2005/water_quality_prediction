# Data — raw dataset tracked via Git LFS; processed and splits remain uncommitted
data/raw/*
data/processed/*
data/splits/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep
!data/raw/Combined_dataset.csv
# The cleaned table is committed as parquet only (45 MB, plain git).
# clean.csv stays ignored: 559 MiB exceeds GitHub's 100 MB plain-git limit, and via LFS
# it would consume most of the free 1 GiB quota. Regenerate it with: python -m src.clean
!data/processed/clean.parquet

